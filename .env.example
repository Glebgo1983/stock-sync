# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local в git не попадает (см. .gitignore).

# Токен mpFit (Bearer). Выдаётся через Telegram-поддержку mpFit.
MPFIT_TOKEN=

# Доступ к inSales REST API (Basic Auth). Создаётся в приложении inSales
# (Настройки -> Приложения -> своё приложение) как пара api_key/password.
INSALES_USERNAME=
INSALES_PASSWORD=

# Домен магазина inSales, например myshop-dbn10.myinsales.ru
INSALES_SHOP_DOMAIN=

# Redis (провижнится через Vercel Marketplace -> Upstash for Redis, есть
# бесплатный тариф). Используется для: кэша статусов заказов (/api/update,
# /api/create), журнала синхронизации остатков и таблицы соответствий
# mpFit<->inSales (/api/sync-stock, /api/sync-log), блокировки от
# параллельных прогонов (SYNC_LOCK_TTL_SECONDS ниже) и курсора
# /api/sync-kiz по ленте /cim-codes (см. SYNC_KIZ_TAIL_HINT ниже).
REDIS_URL=

# Список исключённых из синхронизации остатков товаров — через запятую, без
# изменения кода. Не обязательны одновременно, можно использовать любой один.
# По артикулу/sku (как в inSales, регистр и пробелы важны после trim):
SYNC_EXCLUDED_SKUS=
# По внутреннему ID товара mpFit — переживает переименование артикула:
SYNC_EXCLUDED_MPFIT_IDS=

# Ручные алиасы для случаев, когда sku в inSales и артикул в mpFit не
# совпадают буквально (например, в mpFit есть суффикс варианта/цвета,
# которого нет в inSales) — через запятую, вида
# insales_sku:mpfit_article. Пример (подтверждённые реальные случаи в этом
# магазине, остаток совпал после алиаса):
# SKU_ALIASES=82FACECREAM002:82FACECREAM002/RICH,82TUBINGMASCARA002:82TUBINGMASCARA002/BROWN
SKU_ALIASES=

# TTL блокировки, защищающей от параллельных запусков /api/sync-stock, в
# секундах. Необязательно — по умолчанию 600 (10 минут). Увеличьте, если
# полная синхронизация каталога стабильно занимает больше этого времени.
SYNC_LOCK_TTL_SECONDS=

# Секрет для /api/stock-webhook (вебхук остатков от mpFit). Сгенерируйте
# сами (например: python -c "import secrets; print(secrets.token_urlsafe(32))")
# и передайте mpFit тем способом, который поддерживает их UI настройки
# вебхука — либо как query-параметр в самом URL:
#   https://<ваш-проект>.vercel.app/api/stock-webhook?secret=<значение>
# либо, если у них есть кастомные заголовки, как
#   Authorization: Bearer <значение>
MPFIT_WEBHOOK_SECRET=

# /api/sync-kiz читает ленту mpFit /cim-codes постранично (по 200 — реальный
# максимум за один запрос) начиная с курсора, сохранённого в Redis
# (REDIS_URL выше) после прошлого прогона — без пропусков, сколько бы кодов
# ни появилось в ленте (она общая на все каналы продаж компании, не только
# на этот магазин) между прогонами. Один прогон сканирует не больше
# SYNC_KIZ_SCAN_MAX_PAGES страниц (см. CIM_SCAN_MAX_PAGES в
# mpfit_cim_client.py) — если реальный бэклог больше, курсор просто
# продвигается настолько, насколько успел, и следующий прогон продолжит
# ровно с этого места (задержка, не потеря).

# Стартовая точка бинарного поиска конца ленты /cim-codes — используется
# только один раз, для самого первого прогона (когда в Redis ещё нет
# сохранённого курсора). По умолчанию 10 000 000 — реальный конец на
# 2026-07-21 был ~12 760 000, так что поиск сходится за несколько запросов.
# Не обязательно обновлять часто — при сильном расхождении поиск просто
# станет чуть медленнее, но не сломается.
SYNC_KIZ_TAIL_HINT=

# ID кастомного поля заказа "КИЗ" в inSales (Настройки -> Параметры заказов).
# Значение по умолчанию соответствует полю, уже созданному в этом магазине
# 2026-07-21. Переопределите, только если поле пересоздавалось и получило
# другой id.
INSALES_KIZ_FIELD_ID=

# ID кастомного поля заказа "MPfit id" в inSales (Настройки -> Параметры
# заказов) -- хранит внутренний ID заказа mpFit, записывается автоматически
# при создании заказа (api/functions.py:new_order_handler). Основной, надёжный
# способ сопоставления заказов для /api/sync-kiz -- сопоставление по `number`
# оказалось ненадёжным (см. README). Значение по умолчанию соответствует полю,
# созданному в этом магазине 2026-07-27. Переопределите, только если поле
# пересоздавалось.
INSALES_MPFIT_ID_FIELD_ID=

# Секрет для защиты /api/sync-stock, /api/sync-log и /api/sync-kiz. Если
# переменная называется именно CRON_SECRET, Vercel Cron Jobs автоматически
# подставит её в заголовок Authorization: Bearer $CRON_SECRET при вызове по
# расписанию. Для ручных проверок и внешнего cron-сервиса передавайте тот же
# заголовок вручную.
CRON_SECRET=

# CDEK / Почта России — используются для получения трек-номеров (не относится
# к синхронизации остатков, но требуются существующему коду заказов).
CDEK_CLIENT=
CDEK_SECRET=
POCHTA_APP_AUTH_TOKEN=
POCHTA_CLIENT_AUTH_KEY=
